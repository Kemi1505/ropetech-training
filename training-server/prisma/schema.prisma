// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  EMAIL_AND_PASSWORD
  GOOGLE
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// UNPAID  -> enrolled, nothing submitted yet
// PENDING -> user said "I have paid" (set by the payment module, TODO)
// APPROVED-> admin confirmed; unlocks the course content

enum PaymentStatus {
  UNPAID
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  password      String?           
  authType      AuthMethod         @default(EMAIL_AND_PASSWORD)
  role          Role               @default(USER)
  isActive      Boolean            @default(true)
  googleId      String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt


  refreshTokens RefreshToken[]
  resetOtps     PasswordResetOtp[]
  profile       Profile?
  enrollments   Enrollment[]
  completions   ContentCompletion[]
   attempts      AssessmentAttempt[]
}

model RefreshToken {
  id        String   @id            // equals the JWT "jti"
  tokenHash String                  // sha256 of the refresh token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  otpHash   String
  attempts  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Every uploaded file lives here as bytes. Never select `data` unless you are streaming the file.
model StoredFile {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  profilePicture       Profile?       @relation("ProfilePicture")
  profileCertification Profile?       @relation("ProfileCertification")
  coursePicture        Course?        @relation("CoursePicture")
  courseContent        CourseContent?
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String? // required when a learner completes the profile, optional for admins created by a superadmin
  company   String?

  hasPreviousCertification Boolean   @default(false)
  certificationApproved    Boolean   @default(false)
  certificationApprovedAt  DateTime?

  pictureFileId       String?     @unique
  picture             StoredFile? @relation("ProfilePicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  certificationFileId String?     @unique
  certificationFile   StoredFile? @relation("ProfileCertification", fields: [certificationFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                            String     @id @default(uuid())
  name                          String
  overview                      String
  learningOutcomes              String[]
  price                         Decimal    @db.Decimal(12, 2)
  requiresPreviousCertification Boolean    @default(false)
  difficulty                    Difficulty
  isPublished                   Boolean    @default(false)
  passMark                      Int? // percent (1-100), set when the assessment is finished
  pictureFileId                 String?    @unique
  picture                       StoredFile? @relation("CoursePicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  createdById                   String?
  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt

  contents    CourseContent[]
  enrollments Enrollment[]
  questions   Question[]
  attempts    AssessmentAttempt[]

  @@index([isPublished])
}

model CourseContent {
  id        String     @id @default(uuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id])
  createdAt DateTime   @default(now())

  completions ContentCompletion[]

  @@index([courseId])
}

model Enrollment {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentStatus       PaymentStatus @default(UNPAID)
  paymentApprovedAt   DateTime?
  paymentApprovedById String?
  enrolledAt          DateTime      @default(now())
  submissions         PaymentSubmission[]

  @@unique([userId, courseId])
  @@index([paymentStatus])
}

model ContentCompletion {
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   String
  content     CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  courseId    String // denormalised so progress can be counted per course
  completedAt DateTime      @default(now())

  @@id([userId, contentId])
  @@index([userId, courseId])
}

// One row per "I have paid" a learner submits. Enrollment.paymentStatus stays the source of truth for access.
model PaymentSubmission {
  id              String        @id @default(uuid())
  enrollmentId    String
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payerName       String // name on the bank transfer
  amountSent      Decimal       @db.Decimal(12, 2)
  expectedAmount  Decimal       @db.Decimal(12, 2) // course price when submitted
  status          PaymentStatus @default(PENDING) // PENDING | APPROVED | REJECTED
  rejectionReason String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  @@index([enrollmentId])
  @@index([status])
}

// Multiple choice: every question has exactly 4 options, exactly one correct
model Question {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  text      String
  position  Int
  createdAt DateTime         @default(now())
  options   QuestionOption[]

  @@index([courseId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int

  @@index([questionId])
}

// Results are stored as a summary, so editing or deleting questions later never changes past scores
model AssessmentAttempt {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score          Int // percent
  correctCount   Int
  totalQuestions Int
  passMark       Int // the pass mark in force when this was submitted
  passed         Boolean
  voided         Boolean  @default(false) // set by an admin reset: stops counting towards the attempt limit
  answers        Json
  submittedAt    DateTime @default(now())

  @@index([userId, courseId])
}

