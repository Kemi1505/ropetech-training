// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum AuthMethod {
  EMAIL_AND_PASSWORD
  GOOGLE
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// UNPAID  -> enrolled, nothing submitted yet
// PENDING -> user said "I have paid" (set by the payment module, TODO)
// APPROVED-> admin confirmed; unlocks the course content
// REJECTED -> admin rejected; learner can submit again

enum PaymentStatus {
  UNPAID
  PENDING
  APPROVED
  REJECTED
}

enum LessonType {
  PDF
  VIDEO
  SLIDES
}

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  CERTIFICATION_APPROVED
  CERTIFICATION_REJECTED
  ASSESSMENT_PASSED
}

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  password      String?           
  authType      AuthMethod         @default(EMAIL_AND_PASSWORD)
  role          Role               @default(USER)
  isActive      Boolean            @default(true)
  googleId      String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt


  refreshTokens RefreshToken[]
  resetOtps     PasswordResetOtp[]
  profile       Profile?
  enrollments   Enrollment[]
  completions   LessonCompletion[]
  attempts      AssessmentAttempt[]
  notifications Notification[]
}

model RefreshToken {
  id        String   @id            // equals the JWT "jti"
  tokenHash String                  // sha256 of the refresh token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  otpHash   String
  attempts  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Every uploaded file lives here as bytes. Never select `data` unless you are streaming the file.
model StoredFile {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  profilePicture       Profile?       @relation("ProfilePicture")
  profileCertification Profile?       @relation("ProfileCertification")
  coursePicture        Course?        @relation("CoursePicture")
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String? // required when a learner completes the profile, optional for admins created by a superadmin
  company   String?

  hasPreviousCertification Boolean   @default(false)
  certificationApproved    Boolean   @default(false)
  certificationApprovedAt  DateTime?
  certificationRejectionReason    String? // set when an admin rejects; cleared when a new file is uploaded
  certificationRejectedAt         DateTime?

  pictureFileId       String?     @unique
  picture             StoredFile? @relation("ProfilePicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  certificationFileId String?     @unique
  certificationFile   StoredFile? @relation("ProfileCertification", fields: [certificationFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id                            String     @id @default(uuid())
  name                          String
  shortDescription              String     @default("")
  description                   String     @map("overview") // column keeps its old name
  learningOutcomes              String[]
  certificationRequirement      String? // text shown to learners, e.g. "Valid Banksman certification required."
  price                         Decimal    @db.Decimal(12, 2)
  requiresPreviousCertification Boolean    @default(false)
  difficulty                    Difficulty
  isPublished                   Boolean    @default(false)
  publishedAt                   DateTime?
  isFeatured                    Boolean    @default(false)
  passMark                      Int? // percent (1-100), set when the assessment is finished
  maxAttempts                   Int        @default(5) // assessment attempts per learner, set by the admin
  pictureFileId                 String?    @unique
  picture                       StoredFile? @relation("CoursePicture", fields: [pictureFileId], references: [id], onDelete: SetNull)
  createdById                   String?
  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt

  sections    Section[]
  lessons     Lesson[]
  enrollments Enrollment[]
  questions   Question[]
  attempts    AssessmentAttempt[]

  @@index([isPublished])
  @@index([isFeatured])
}

model Section {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  createdAt DateTime @default(now())
  lessons   Lesson[]

  @@index([courseId])
}

// One file per lesson. The file itself is in S3 under `fileKey`.
model Lesson {
  id          String             @id @default(uuid())
  sectionId   String
  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId    String // repeated here so progress can be counted per course without a join
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  type        LessonType
  position    Int
  fileKey     String
  fileName    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime           @default(now())
  completions LessonCompletion[]

  @@index([sectionId])
  @@index([courseId])
}

model LessonCompletion {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId    String
  completedAt DateTime @default(now())

  @@id([userId, lessonId])
  @@index([userId, courseId])
}

model Enrollment {
  id                  String        @id @default(uuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  paymentStatus       PaymentStatus @default(UNPAID)
  paymentApprovedAt   DateTime?
  paymentApprovedById String?
  enrolledAt          DateTime      @default(now())
  lastOpenedAt        DateTime? // powers "Continue learning"
  lastLessonId        String?
  submissions         PaymentSubmission[]

  @@unique([userId, courseId])
  @@index([paymentStatus])

}

// One row per "I have paid" a learner submits. Enrollment.paymentStatus stays the source of truth for access.
model PaymentSubmission {
  id              String        @id @default(uuid())
  enrollmentId    String
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  payerName       String // name on the bank transfer
  amountSent      Decimal       @db.Decimal(12, 2)
  expectedAmount  Decimal       @db.Decimal(12, 2) // course price when submitted
  status          PaymentStatus @default(PENDING) // PENDING | APPROVED | REJECTED
  rejectionReason String?
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedById    String?

  @@index([enrollmentId])
  @@index([status])
}

// Multiple choice: every question has exactly 4 options, exactly one correct
model Question {
  id        String           @id @default(uuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  text      String
  position  Int
  createdAt DateTime         @default(now())
  options   QuestionOption[]

  @@index([courseId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  position   Int

  @@index([questionId])
}

// Results are stored as a summary, so editing or deleting questions later never changes past scores
model AssessmentAttempt {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score          Int // percent
  correctCount   Int
  totalQuestions Int
  passMark       Int // the pass mark in force when this was submitted
  passed         Boolean
  voided         Boolean  @default(false) // set by an admin reset: stops counting towards the attempt limit
  answers        Json
  submittedAt    DateTime @default(now())

  @@index([userId, courseId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String? // frontend path to open, e.g. /courses/<id>
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}



model AnotherStoredFile {
  key          String   @id
  data         Bytes
  contentType  String
  size         Int      @default(0)
  expectedSize Int
  uploaded     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
